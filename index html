        if (!att) return;
        if (save.balance < att.price) return;
        save.ownedAtts[wid] = save.ownedAtts[wid] || [];
        if (save.ownedAtts[wid].includes(attId)) return;
        save.balance -= att.price;
        save.ownedAtts[wid].push(attId);
        persist();
        renderShop();
        buildWeaponsBar();
