      card.innerHTML =
        `<div class="att-icon">${att.icon}</div>` +
        `<div class="att-info">` +
          `<div class="att-title">${att.name}</div>` +
          `<div class="att-desc">${att.desc}</div>` +
          `<div class="att-weapons">Совместимо: ${att.weapons.map(wid => getWeapon(wid).name).join(', ')}</div>` +
