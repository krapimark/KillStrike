  function update() {
    if (!gameRunning || !player || paused) return;

    battleSaveTimer++;
    if (battleSaveTimer >= 180) {
      battleSaveTimer = 0;
      saveBattle(false);
    }

    let mvLen = Math.hypot(joyMove.dx, joyMove.dy);
    if (mvLen > 0.15) {
      let nx = player.x + joyMove.dx * player.speed;
      let ny = player.y + joyMove.dy * player.speed;
      let p1 = resolveCollision(nx, player.y, player.r);
      let p2 = resolveCollision(p1.x, ny, player.r);
      player.x = p2.x;
      player.y = p2.y;
    }
    player.x = Math.max(player.r, Math.min(W - player.r, player.x));
    player.y = Math.max(player.r, Math.min(H - player.r, player.y));

    let shootLen = Math.hypot(joyShoot.dx, joyShoot.dy);
    if (shootLen > 0.3) {
      player.aimAngle = Math.atan2(joyShoot.dy, joyShoot.dx);
      if (player.shootCooldown <= 0) shoot(player.aimAngle);
    } else if (mvLen > 0.15) {
      player.aimAngle = Math.atan2(joyMove.dy, joyMove.dx);
    }

    if (player.shootCooldown > 0) player.shootCooldown--;
    if (player.invuln > 0) player.invuln--;

    if (currentWeapon.isMelee) {
      player.knifeAngle = ((player.knifeAngle || 0) + currentWeapon.orbitSpeed) % (Math.PI * 2);
      updateKnifeDamage();
    }

    updateGrenades();

    if (boss) {
      updateBoss();
      if (!boss) { victory(); return; }
    }

    for (let i = bullets.length - 1; i >= 0; i--) {
      const b = bullets[i];
      b.x += b.vx; b.y += b.vy; b.life--;
      if (b.x < -30 || b.x > W + 30 || b.y < -30 || b.y > H + 30 || b.life <= 0) {
        bullets.splice(i, 1); continue;
      }
      if (hitsObstacle(b.x, b.y, b.r)) {
        explode(b.x, b.y, b.color, 4);
        bullets.splice(i, 1); continue;
      }
      if (boss) {
        const dBoss = Math.hypot(b.x - boss.x, b.y - boss.y);
        if (dBoss < boss.r + b.r) {
          boss.hp -= b.damage;
          boss.hitFlash = 8;
          explode(b.x, b.y, '#ff2266', 6);
          bullets.splice(i, 1);
          updateBossBar();
          if (boss.hp <= 0) {
            explode(boss.x, boss.y, '#ff2266', 80);
            explode(boss.x, boss.y, '#aa00ff', 80);
            for (let k = 0; k < 10; k++) spawnNFT(boss.x + (Math.random()-0.5)*80, boss.y + (Math.random()-0.5)*80);
            score += 500; nftCount += 10;
            updateUI();
            boss = null; updateBossBar();
            victory(); return;
          }
          continue;
        }
      }
      let hit = false;
      for (let j = enemies.length - 1; j >= 0; j--) {
        const e = enemies[j];
        if (Math.hypot(b.x - e.x, b.y - e.y) < e.r + b.r) {
          e.hp -= b.damage;
          explode(b.x, b.y, e.color, 5);
          hit = true;
          if (e.hp <= 0) {
            score += e.score;
            explode(e.x, e.y, e.color, 22);
            if (Math.random() < 0.4) spawnNFT(e.x, e.y);
            enemies.splice(j, 1);
            updateUI();
          }
          break;
        }
      }
      if (hit) bullets.splice(i, 1);
    }

    for (let i = enemies.length - 1; i >= 0; i--) {
      const e = enemies[i];
      const dx = player.x - e.x, dy = player.y - e.y;
      const dist = Math.hypot(dx, dy) || 1;
      let nx = e.x + (dx / dist) * e.speed;
      let ny = e.y + (dy / dist) * e.speed;
      let p1 = resolveCollision(nx, e.y, e.r);
      let p2 = resolveCollision(p1.x, ny, e.r);
      e.x = p2.x; e.y = p2.y;
      e.angle = Math.atan2(dy, dx);
      e.walkPhase += 0.2;

      if (e.shoot) {
        e.shootCooldown--;
        if (e.shootCooldown <= 0 && dist < 500) {
          let blocked = false;
          const steps = 12;
          for (let s = 1; s < steps; s++) {
            const tx = e.x + (dx / steps) * s;
            const ty = e.y + (dy / steps) * s;
            if (hitsObstacle(tx, ty, 2)) { blocked = true; break; }
          }
          if (!blocked) {
            enemyBullets.push({
              x: e.x, y: e.y,
              vx: (dx / dist) * 4, vy: (dy / dist) * 4,
              r: 6, life: 200, color: save.mode === 'space' ? '#ff44ff' : (save.mode === 'zombie' ? '#aaff00' : '#ff8800')
            });
            e.shootCooldown = 100;
          } else e.shootCooldown = 30;
        }
      }

      if (dist < e.r + player.r && player.invuln <= 0) {
        player.hp -= 12; player.invuln = 40;
        explode(player.x, player.y, '#ff0000', 15);
        updateUI();
        if (player.hp <= 0) { gameOver(); return; }
      }
    }

    for (let i = enemyBullets.length - 1; i >= 0; i--) {
      const b = enemyBullets[i];
      b.x += b.vx; b.y += b.vy; b.life--;
      if (b.x < -30 || b.x > W + 30 || b.y < -30 || b.y > H + 30 || b.life <= 0) {
        enemyBullets.splice(i, 1); continue;
      }
      if (hitsObstacle(b.x, b.y, b.r)) {
        explode(b.x, b.y, b.color, 3);
        enemyBullets.splice(i, 1); continue;
      }
      if (Math.hypot(b.x - player.x, b.y - player.y) < player.r + b.r && player.invuln <= 0) {
        enemyBullets.splice(i, 1);
        player.hp -= 10; player.invuln = 40;
        explode(player.x, player.y, '#ff0000', 12);
        updateUI();
        if (player.hp <= 0) { gameOver(); return; }
      }
    }

    for (let i = nfts.length - 1; i >= 0; i--) {
      const n = nfts[i];
      n.bob += 0.15; n.life--;
      if (n.life <= 0) { nfts.splice(i, 1); continue; }
      const d = Math.hypot(n.x - player.x, n.y - player.y);
      if (d < player.r + n.r + 15) {
        nftCount++; score += 50;
        explode(n.x, n.y, `hsl(${n.hue},100%,60%)`, 15);
        nfts.splice(i, 1); updateUI(); continue;
      }
      if (d < 130) {
        const stepX = (player.x - n.x) * 0.12;
        const stepY = (player.y - n.y) * 0.12;
        if (!hitsObstacle(n.x + stepX, n.y + stepY, n.r)) {
          n.x += stepX; n.y += stepY;
        }
      }
    }

    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.x += p.vx; p.y += p.vy;
      p.vx *= 0.96; p.vy *= 0.96;
      p.life--;
      if (p.life <= 0) particles.splice(i, 1);
    }

    if (wave < MAX_WAVES) {
      spawnTimer--;
      const maxEnemies = 4 + wave * 2;
      if (spawnTimer <= 0 && enemies.length < maxEnemies) {
        spawnEnemy();
        spawnTimer = Math.max(25, 70 - wave * 3);
      }
    } else if (wave === MAX_WAVES && !boss && !victoryTriggered) {
      if (enemies.length === 0) spawnBoss();
    }

    if (wave < MAX_WAVES && score >= wave * 200) {
      wave++;
      battlePointsEarned++;
      if (save.profile) {
        save.profile.points = (save.profile.points || 0) + 1;
        persist();
      }
      updateUI();
      explode(W/2, H/2, '#00f0ff', 40);
    }

    if (wave === MAX_WAVES && !boss && !victoryTriggered) {
      if (enemies.length === 0) spawnBoss();
    }
  }

  function updateBoss() {
    if (!boss) return;
    boss.hitFlash = Math.max(0, boss.hitFlash - 1);
    boss.angle += 0.01;
    boss.walkPhase += 0.06;

    const dx = player.x - boss.x, dy = player.y - boss.y;
    const dist = Math.hypot(dx, dy) || 1;
    let nx = boss.x + (dx / dist) * boss.speed;
    let ny = boss.y + (dy / dist) * boss.speed;
    let p1 = resolveCollision(nx, boss.y, boss.r);
    let p2 = resolveCollision(p1.x, ny, boss.r);
    boss.x = p2.x; boss.y = p2.y;
    boss.angle = Math.atan2(dy, dx);

    boss.invisible = (boss.invisible || 0) + 1;

    boss.shootCd--;
    if (boss.shootCd <= 0 && dist < 700) {
      const count = boss.hp < boss.maxHp / 2 ? 7 : 5;
      const spread = 0.9;
      for (let i = 0; i < count; i++) {
        const a = boss.angle + (i - (count - 1) / 2) * (spread / (count - 1));
        const sx = boss.x + Math.cos(a) * boss.r;
        const sy = boss.y + Math.sin(a) * boss.r;
        if (hitsObstacle(sx, sy, 6)) continue;
        enemyBullets.push({
          x: sx, y: sy,
          vx: Math.cos(a) * 4.5, vy: Math.sin(a) * 4.5,
          r: 7, life: 260, color: '#ff2266'
        });
      }
      boss.shootCd = boss.hp < boss.maxHp / 2 ? 55 : 80;
    }

    boss.summonCd--;
    if (boss.summonCd <= 0) {
      for (let i = 0; i < 3; i++) {
        const ang = Math.random() * Math.PI * 2;
        const sx = boss.x + Math.cos(ang) * (boss.r + 30);
        const sy = boss.y + Math.sin(ang) * (boss.r + 30);
        if (!isFreeSpot(sx, sy, 14)) continue;
        const colors = getEnemyColors();
        enemies.push({
          x: sx, y: sy, r: 14, hp: 20, maxHp: 20,
          speed: 2.0, color: colors.a, shoot: false, score: 15,
          shootCooldown: 0, angle: 0, walkPhase: 0
        });
      }
      boss.summonCd = 360;
    }

    if (dist < boss.r + player.r && player.invuln <= 0) {
      player.hp -= 20; player.invuln = 50;
      explode(player.x, player.y, '#ff0000', 15);
      updateUI();
      if (player.hp <= 0) { gameOver(); return; }
    }
  }

  function drawHumanoid(x, y, r, bodyColor, outlineColor, angle, walkPhase, glowColor, accentColor) {
    if (glowColor) {
      const g = ctx.createRadialGradient(x, y, 0, x, y, r * 2.2);
      g.addColorStop(0, glowColor);
      g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.globalAlpha = 0.5;
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(x, y, r * 2.2, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 1;
    }

    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(angle + Math.PI / 2);

    ctx.lineWidth = 2;
    ctx.strokeStyle = outlineColor;
    ctx.fillStyle = bodyColor;

    ctx.globalAlpha = 0.3;
    ctx.fillStyle = '#000';
    ctx.beginPath();
    ctx.ellipse(0, r * 0.9, r * 0.7, r * 0.25, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalAlpha = 1;
    ctx.fillStyle = bodyColor;

    const legSwing = Math.sin(walkPhase) * r * 0.35;
    ctx.beginPath();
    ctx.moveTo(-r * 0.4, r * 0.3);
    ctx.lineTo(-r * 0.4 + legSwing, r * 0.95);
    ctx.lineTo(-r * 0.15 + legSwing, r * 0.95);
    ctx.lineTo(-r * 0.15, r * 0.3);
    ctx.closePath();
    ctx.fill(); ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(r * 0.4, r * 0.3);
    ctx.lineTo(r * 0.4 - legSwing, r * 0.95);
    ctx.lineTo(r * 0.15 - legSwing, r * 0.95);
    ctx.lineTo(r * 0.15, r * 0.3);
    ctx.closePath();
    ctx.fill(); ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(-r * 0.5, -r * 0.2);
    ctx.lineTo(r * 0.5, -r * 0.2);
    ctx.lineTo(r * 0.4, r * 0.35);
    ctx.lineTo(-r * 0.4, r * 0.35);
    ctx.closePath();
    ctx.fill(); ctx.stroke();

    const armSwing = Math.sin(walkPhase + Math.PI) * r * 0.3;
    ctx.beginPath();
    ctx.moveTo(-r * 0.5, -r * 0.05);
    ctx.lineTo(-r * 0.75, r * 0.35 + armSwing);
    ctx.lineTo(-r * 0.6, r * 0.45 + armSwing);
    ctx.lineTo(-r * 0.35, r * 0.05);
    ctx.closePath();
    ctx.fill(); ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(r * 0.5, -r * 0.05);
    ctx.lineTo(r * 0.75, r * 0.35 - armSwing);
    ctx.lineTo(r * 0.6, r * 0.45 - armSwing);
    ctx.lineTo(r * 0.35, r * 0.05);
    ctx.closePath();
    ctx.fill(); ctx.stroke();

    ctx.beginPath();
    ctx.arc(0, -r * 0.55, r * 0.42, 0, Math.PI * 2);
    ctx.fill(); ctx.stroke();

    ctx.fillStyle = accentColor || outlineColor;
    ctx.beginPath();
    ctx.arc(-r * 0.15, -r * 0.6, r * 0.1, 0, Math.PI * 2);
    ctx.arc(r * 0.15, -r * 0.6, r * 0.1, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = outlineColor;
    ctx.fillRect(r * 0.55, -r * 0.15, r * 0.5, r * 0.15);

    ctx.restore();
  }

  function drawKnife(px, py, angle, w) {
    const bx = px + Math.cos(angle) * w.orbitRadius;
    const by = py + Math.sin(angle) * w.orbitRadius;

    ctx.save();
    for (let i = 5; i >= 1; i--) {
      const a = angle - i * 0.1;
      const tx = px + Math.cos(a) * w.orbitRadius;
      const ty = py + Math.sin(a) * w.orbitRadius;
      ctx.globalAlpha = 0.4 - i * 0.06;
      ctx.fillStyle = w.color;
      ctx.beginPath();
      ctx.arc(tx, ty, w.bladeR * (1 - i * 0.12), 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
    ctx.globalAlpha = 1;

    const t = performance.now() / 1000;

    ctx.save();
    ctx.translate(bx, by);
    ctx.rotate(angle + Math.PI / 2);
    ctx.shadowBlur = 18;
    ctx.shadowColor = w.color;

    if (w.id === 'butterfly') {
      const swing = Math.sin(t * 8) * 0.28;

      ctx.save();
      ctx.rotate(-0.45 + swing);
      const gL = ctx.createLinearGradient(0, 0, -w.bladeR, w.bladeR * 0.5);
      gL.addColorStop(0, '#5a7a9a');
      gL.addColorStop(1, '#2a3a5a');
      ctx.fillStyle = gL;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.quadraticCurveTo(-w.bladeR * 0.7, w.bladeR * 0.1, -w.bladeR * 0.95, w.bladeR * 0.5);
      ctx.quadraticCurveTo(-w.bladeR * 0.7, w.bladeR * 0.62, -w.bladeR * 0.5, w.bladeR * 0.5);
      ctx.quadraticCurveTo(-w.bladeR * 0.2, w.bladeR * 0.3, 0, w.bladeR * 0.15);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = '#88ccff';
      ctx.lineWidth = 1.2;
      ctx.stroke();
      ctx.strokeStyle = 'rgba(136,204,255,0.45)';
      ctx.lineWidth = 1;
      for (let i = 1; i <= 4; i++) {
        const p = i / 5;
        const xx = -w.bladeR * 0.85 * p;
        const yy = w.bladeR * 0.48 * p;
        ctx.beginPath();
        ctx.moveTo(xx - 2, yy - 2);
        ctx.lineTo(xx + 2, yy + 2);
        ctx.stroke();
      }
      ctx.restore();

      ctx.save();
      ctx.rotate(0.45 - swing);
      const gR = ctx.createLinearGradient(0, 0, w.bladeR, w.bladeR * 0.5);
      gR.addColorStop(0, '#5a7a9a');
      gR.addColorStop(1, '#2a3a5a');
      ctx.fillStyle = gR;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.quadraticCurveTo(w.bladeR * 0.7, w.bladeR * 0.1, w.bladeR * 0.95, w.bladeR * 0.5);
      ctx.quadraticCurveTo(w.bladeR * 0.7, w.bladeR * 0.62, w.bladeR * 0.5, w.bladeR * 0.5);
      ctx.quadraticCurveTo(w.bladeR * 0.2, w.bladeR * 0.3, 0, w.bladeR * 0.15);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = '#88ccff';
      ctx.lineWidth = 1.2;
      ctx.stroke();
      ctx.strokeStyle = 'rgba(136,204,255,0.45)';
      ctx.lineWidth = 1;
      for (let i = 1; i <= 4; i++) {
        const p = i / 5;
        const xx = w.bladeR * 0.85 * p;
        const yy = w.bladeR * 0.48 * p;
        ctx.beginPath();
        ctx.moveTo(xx - 2, yy - 2);
        ctx.lineTo(xx + 2, yy + 2);
        ctx.stroke();
      }
      ctx.restore();

      const bladeG = ctx.createLinearGradient(0, -w.bladeR * 1.2, 0, w.bladeR * 0.35);
      bladeG.addColorStop(0, '#ffffff');
      bladeG.addColorStop(0.5, '#cceeff');
      bladeG.addColorStop(1, '#88ccff');
      ctx.fillStyle = bladeG;
      ctx.beginPath();
      ctx.moveTo(0, -w.bladeR * 1.25);
      ctx.lineTo(w.bladeR * 0.28, -w.bladeR * 0.2);
      ctx.lineTo(w.bladeR * 0.2, w.bladeR * 0.35);
      ctx.lineTo(-w.bladeR * 0.2, w.bladeR * 0.35);
      ctx.lineTo(-w.bladeR * 0.28, -w.bladeR * 0.2);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1;
      ctx.stroke();

      ctx.strokeStyle = 'rgba(255,255,255,0.7)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, -w.bladeR * 1.2);
      ctx.lineTo(0, w.bladeR * 0.3);
      ctx.stroke();

      ctx.fillStyle = '#ffffff';
      ctx.shadowBlur = 10;
      ctx.shadowColor = '#88ccff';
      ctx.beginPath();
      ctx.arc(0, 0, 3, 0, Math.PI * 2);
      ctx.fill();

    } else if (w.id === 'karambit') {
      ctx.strokeStyle = '#ffcc66';
      ctx.lineWidth = 3;
      ctx.shadowBlur = 12;
      ctx.shadowColor = '#ffaa44';
      ctx.beginPath();
      ctx.arc(w.bladeR * 0.1, w.bladeR * 0.75, w.bladeR * 0.38, 0, Math.PI * 2);
      ctx.stroke();

      const handleG = ctx.createLinearGradient(0, w.bladeR * 0.1, 0, w.bladeR * 0.8);
      handleG.addColorStop(0, '#5a3a1a');
      handleG.addColorStop(1, '#2a1a0a');
      ctx.fillStyle = handleG;
      ctx.beginPath();
      ctx.moveTo(-w.bladeR * 0.22, w.bladeR * 0.2);
      ctx.quadraticCurveTo(-w.bladeR * 0.15, w.bladeR * 0.65, w.bladeR * 0.1, w.bladeR * 0.55);
      ctx.quadraticCurveTo(w.bladeR * 0.35, w.bladeR * 0.65, w.bladeR * 0.28, w.bladeR * 0.2);
      ctx.lineTo(w.bladeR * 0.22, w.bladeR * 0.1);
      ctx.lineTo(-w.bladeR * 0.16, w.bladeR * 0.1);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = '#ffaa44';
      ctx.lineWidth = 1.2;
      ctx.stroke();

      const bladeG2 = ctx.createLinearGradient(0, -w.bladeR, 0, 0);
      bladeG2.addColorStop(0, '#ffffff');
      bladeG2.addColorStop(0.6, '#ffddbb');
      bladeG2.addColorStop(1, '#ffaa44');
      ctx.fillStyle = bladeG2;
      ctx.shadowBlur = 20;
      ctx.shadowColor = '#ff8844';
      ctx.beginPath();
      ctx.moveTo(-w.bladeR * 0.2, w.bladeR * 0.15);
      ctx.bezierCurveTo(
        -w.bladeR * 1.2, -w.bladeR * 0.2,
        -w.bladeR * 1.1, -w.bladeR * 0.9,
        -w.bladeR * 0.4, -w.bladeR * 1.25
      );
      ctx.lineTo(-w.bladeR * 0.25, -w.bladeR * 1.15);
      ctx.bezierCurveTo(
        -w.bladeR * 0.5, -w.bladeR * 0.7,
        -w.bladeR * 0.4, -w.bladeR * 0.2,
        w.bladeR * 0.2, w.bladeR * 0.15
      );
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1.2;
      ctx.stroke();

      ctx.shadowBlur = 0;
      ctx.strokeStyle = 'rgba(255,255,255,0.8)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.bezierCurveTo(
        -w.bladeR * 1.1, -w.bladeR * 0.25,
        -w.bladeR * 1.0, -w.bladeR * 0.85,
        -w.bladeR * 0.42, -w.bladeR * 1.15
      );
      ctx.stroke();

      ctx.fillStyle = '#ffcc66';
      ctx.shadowBlur = 4;
      ctx.shadowColor = '#ffaa44';
      ctx.beginPath();
      ctx.arc(w.bladeR * 0.0, w.bladeR * 0.35, 1.8, 0, Math.PI * 2);
      ctx.arc(w.bladeR * 0.05, w.bladeR * 0.5, 1.8, 0, Math.PI * 2);
      ctx.fill();

    } else {
      const g = ctx.createLinearGradient(0, -w.bladeR * 1.1, 0, w.bladeR * 0.45);
      g.addColorStop(0, '#ffffff');
      g.addColorStop(0.7, '#ddeeff');
      g.addColorStop(1, '#aaccdd');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.moveTo(0, -w.bladeR * 1.1);
      ctx.lineTo(w.bladeR * 0.35, w.bladeR * 0.4);
      ctx.lineTo(-w.bladeR * 0.35, w.bladeR * 0.4);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1;
      ctx.stroke();

      ctx.fillStyle = '#2a2a3a';
      ctx.fillRect(-3, w.bladeR * 0.4, 6, w.bladeR * 0.65);
      ctx.strokeStyle = '#888';
      ctx.lineWidth = 1;
      ctx.strokeRect(-3, w.bladeR * 0.4, 6, w.bladeR * 0.65);

      ctx.shadowBlur = 0;
      ctx.strokeStyle = 'rgba(255,255,255,0.7)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, -w.bladeR * 1.0);
      ctx.lineTo(w.bladeR * 0.2, w.bladeR * 0.35);
      ctx.stroke();
    }

    ctx.restore();
    ctx.shadowBlur = 0;
  }

  function drawBoss() {
    if (!boss) return;
    const t = performance.now() / 1000;
    const cycle = (boss.invisible || 0) % 240;
    let alpha = 1;
    let ghost = 0;
    if (cycle > 150) {
      const p = (cycle - 150) / 90;
      const blink = Math.sin(p * Math.PI * 8);
      if (blink > 0.3) alpha = 0.12;
      else alpha = 0.5 + 0.4 * Math.random();
      ghost = 1;
    }

    const auraR = boss.r * 2.0;
    const g = ctx.createRadialGradient(boss.x, boss.y, 0, boss.x, boss.y, auraR);
    g.addColorStop(0, `rgba(255,34,102,${0.4 * alpha})`);
    g.addColorStop(0.6, `rgba(170,0,255,${0.2 * alpha})`);
    g.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.globalAlpha = alpha * 0.9;
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(boss.x, boss.y, auraR, 0, Math.PI * 2); ctx.fill();
    ctx.globalAlpha = 1;

    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.translate(boss.x, boss.y);
    ctx.rotate(boss.angle + Math.PI / 2);

    ctx.fillStyle = 'rgba(10,10,26,0.85)';
    ctx.beginPath(); ctx.arc(0, 0, boss.r * 0.95, 0, Math.PI * 2); ctx.fill();

    const teeth = 12;
    ctx.fillStyle = '#ff2266';
    ctx.shadowBlur = 20;
    ctx.shadowColor = '#ff2266';
    ctx.beginPath();
    for (let i = 0; i < teeth * 2; i++) {
      const a = (i / (teeth * 2)) * Math.PI * 2;
      const rr = (i % 2 === 0) ? boss.r : boss.r * 0.82;
      const x = Math.cos(a) * rr;
      const y = Math.sin(a) * rr;
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.closePath();
    ctx.fill();
    ctx.shadowBlur = 0;

    ctx.strokeStyle = '#aa00ff';
    ctx.lineWidth = 3;
    ctx.shadowBlur = 15;
    ctx.shadowColor = '#aa00ff';
    ctx.beginPath();
    ctx.arc(0, 0, boss.r * 0.55, 0, Math.PI * 2);
    ctx.stroke();
    ctx.shadowBlur = 0;

    const pulse = 1 + Math.sin(t * 4) * 0.08;
    const coreR = boss.r * 0.32 * pulse;
    const cg = ctx.createRadialGradient(0, 0, 0, 0, 0, coreR);
    cg.addColorStop(0, '#ffffff');
    cg.addColorStop(0.4, '#ff2266');
    cg.addColorStop(1, 'rgba(170,0,255,0)');
    ctx.fillStyle = cg;
    ctx.beginPath(); ctx.arc(0, 0, coreR, 0, Math.PI * 2); ctx.fill();

    ctx.fillStyle = '#0a0a1a';
    ctx.beginPath(); ctx.arc(0, -coreR * 0.3, coreR * 0.35, 0, Math.PI * 2); ctx.fill();

    if (boss.hitFlash > 0) {
      ctx.globalAlpha = (boss.hitFlash / 8) * 0.7;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath(); ctx.arc(0, 0, boss.r, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = alpha;
    }

    if (ghost) {
      ctx.globalAlpha = 0.4;
      ctx.strokeStyle = '#aa00ff';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(0, 0, boss.r * 1.15, 0, Math.PI * 2); ctx.stroke();
    }

    ctx.restore();
    ctx.globalAlpha = 1;
  }

  function drawObstacles() {
    if (!currentMap) return;
    for (const o of currentMap) {
      const grad = ctx.createLinearGradient(
        (o.type === 'rect' ? o.x : o.type === 'circle' ? o.cx - o.r : o.points[0].x),
        (o.type === 'rect' ? o.y : o.type === 'circle' ? o.cy - o.r : o.points[0].y),
        (o.type === 'rect' ? o.x + o.w : o.type === 'circle' ? o.cx + o.r : o.points[0].x + 40),
        (o.type === 'rect' ? o.y + o.h : o.type === 'circle' ? o.cy + o.r : o.points[0].y + 40)
      );
      grad.addColorStop(0, 'rgba(0,240,255,0.10)');
      grad.addColorStop(1, 'rgba(170,68,255,0.10)');
      ctx.fillStyle = grad;
      ctx.strokeStyle = 'rgba(0,240,255,0.55)';
      ctx.lineWidth = 2;
      ctx.shadowBlur = 12;
      ctx.shadowColor = 'rgba(0,240,255,0.4)';

      if (o.type === 'rect') {
        ctx.beginPath();
        ctx.rect(o.x, o.y, o.w, o.h);
        ctx.fill(); ctx.stroke();
        ctx.shadowBlur = 0;
        ctx.strokeStyle = 'rgba(0,240,255,0.15)';
        ctx.lineWidth = 1;
        for (let gx = o.x + 10; gx < o.x + o.w; gx += 14) {
          ctx.beginPath(); ctx.moveTo(gx, o.y); ctx.lineTo(gx, o.y + o.h); ctx.stroke();
        }
        for (let gy = o.y + 10; gy < o.y + o.h; gy += 14) {
          ctx.beginPath(); ctx.moveTo(o.x, gy); ctx.lineTo(o.x + o.w, gy); ctx.stroke();
        }
      } else if (o.type === 'circle') {
        ctx.beginPath();
        ctx.arc(o.cx, o.cy, o.r, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
        ctx.shadowBlur = 0;
        ctx.strokeStyle = 'rgba(0,240,255,0.2)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(o.cx, o.cy, o.r * 0.6, 0, Math.PI * 2);
        ctx.stroke();
      } else if (o.type === 'poly') {
        ctx.beginPath();
        o.points.forEach((p, i) => {
          if (i === 0) ctx.moveTo(p.x, p.y);
          else ctx.lineTo(p.x, p.y);
        });
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }
      ctx.shadowBlur = 0;
    }
  }

  function draw() {
    ctx.fillStyle = '#0a0a1a';
    ctx.fillRect(0, 0, W, H);
    ctx.strokeStyle = 'rgba(0,240,255,0.06)';
    ctx.lineWidth = 1;
    for (let x = 0; x < W; x += 40) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
    for (let y = 0; y < H; y += 40) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }

    drawObstacles();

    if (!player) return;
    const t = performance.now() / 1000;

    for (const n of nfts) {
      const yy = n.y + Math.sin(n.bob) * 4;
      const hue = n.hueShift ? (n.hue + t * 100) % 360 : n.hue;
      const glow = ctx.createRadialGradient(n.x, yy, 0, n.x, yy, 22);
      glow.addColorStop(0, `hsla(${hue},100%,70%,0.9)`);
      glow.addColorStop(1, `hsla(${hue},100%,50%,0)`);
      ctx.fillStyle = glow;
      ctx.beginPath(); ctx.arc(n.x, yy, 22, 0, Math.PI * 2); ctx.fill();

      ctx.save(); ctx.translate(n.x, yy); ctx.rotate(t * 2);
      ctx.fillStyle = `hsl(${hue},100%,60%)`;
      ctx.strokeStyle = '#fff'; ctx.lineWidth = 2;
      ctx.beginPath();
      for (let i = 0; i < 6; i++) {
        const a = (i / 6) * Math.PI * 2;
        const px = Math.cos(a) * n.r, py = Math.sin(a) * n.r;
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      }
      ctx.closePath(); ctx.fill(); ctx.stroke();
      ctx.restore();
    }

    for (const g of thrownGrenades) {
      const k = g.t / g.total;
      const scale = 1 + Math.sin(k * Math.PI) * 0.3;
      ctx.save();
      ctx.translate(g.x, g.y);
      ctx.shadowBlur = 14; ctx.shadowColor = '#aa00ff';
      ctx.fillStyle = '#aa00ff';
      ctx.beginPath(); ctx.arc(0, 0, g.r * scale, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#ff44ff';
      ctx.beginPath(); ctx.arc(0, 0, g.r * 0.5 * scale, 0, Math.PI * 2); ctx.fill();
      ctx.restore();
      ctx.shadowBlur = 0;
    }

    drawBoss();

    for (const e of enemies) {
      drawHumanoid(e.x, e.y, e.r, e.color, '#ffffff', e.angle, e.walkPhase, e.color + '88', '#ffffff');
      const hpPct = e.hp / e.maxHp;
      ctx.fillStyle = 'rgba(0,0,0,0.7)';
      ctx.fillRect(e.x - e.r, e.y - e.r - 14, e.r * 2, 5);
      ctx.fillStyle = '#ff2266';
      ctx.fillRect(e.x - e.r, e.y - e.r - 14, e.r * 2 * hpPct, 5);
      ctx.strokeStyle = 'rgba(255,255,255,0.4)';
      ctx.lineWidth = 1;
      ctx.strokeRect(e.x - e.r, e.y - e.r - 14, e.r * 2, 5);
    }

    for (const b of bullets) {
      ctx.fillStyle = b.color;
      ctx.shadowBlur = 12; ctx.shadowColor = b.color;
      ctx.beginPath(); ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2); ctx.fill();
      ctx.shadowBlur = 0;
    }
    for (const b of enemyBullets) {
      ctx.fillStyle = b.color;
      ctx.shadowBlur = 10; ctx.shadowColor = b.color;
      ctx.beginPath(); ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2); ctx.fill();
      ctx.shadowBlur = 0;
    }

    for (const p of particles) {
      const a = p.life / p.maxLife;
      ctx.globalAlpha = a;
      ctx.fillStyle = p.color;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.r * a, 0, Math.PI * 2); ctx.fill();
    }
    ctx.globalAlpha = 1;

    const blink = player.invuln > 0 && Math.floor(t * 20) % 2 === 0;
    ctx.globalAlpha = blink ? 0.4 : 1;

    const mvLen = Math.hypot(joyMove.dx, joyMove.dy);
    if (mvLen > 0.15) player.walkPhase += 0.25;

    const sk = player.skin;
    drawHumanoid(
      player.x, player.y, player.r,
      sk.color, sk.accent,
      player.aimAngle,
      player.walkPhase,
      sk.glow,
      sk.accent
    );

    ctx.globalAlpha = 1;

    if (currentWeapon.isMelee && player) {
      drawKnife(player.x, player.y, player.knifeAngle || 0, currentWeapon);
    }
  }

  function loop() {
    if (gameRunning && !paused) update();
    draw();
    requestAnimationFrame(loop);
  }

  function startGame() {
    clearBattle();
    initGame();
    buildWeaponsBar();
    overlay.classList.add('hidden');
    lobbyScreen.classList.add('hidden');
    shopScreen.classList.add('hidden');
    modeScreen.classList.add('hidden');
    loadoutScreen.classList.add('hidden');
    profileScreen.classList.add('hidden');
    battleSaveTimer = 0;
    gameRunning = true;
    paused = false;
    pauseOverlay.classList.add('hidden');
    pauseBtn.classList.add('show');
    pauseBtn.textContent = '⏸';
    saveBattle(false);
  }

  function continueGame() {
    const data = loadBattle();
    if (!data) { startGame(); return; }
    restoreBattle(data);
    overlay.classList.add('hidden');
    lobbyScreen.classList.add('hidden');
    shopScreen.classList.add('hidden');
    modeScreen.classList.add('hidden');
    loadoutScreen.classList.add('hidden');
    profileScreen.classList.add('hidden');
    battleSaveTimer = 0;
    gameRunning = true;
    paused = false;
    pauseOverlay.classList.add('hidden');
    pauseBtn.classList.add('show');
    pauseBtn.textContent = '⏸';
  }

  function refreshContinueButton() {
    const wrap = document.getElementById('continueWrap');
    if (!wrap) return;
    const data = loadBattle();
    if (data) {
      wrap.classList.remove('hidden');
      const w = document.getElementById('contWave');
      if (w) w.textContent = data.wave || 1;
    } else wrap.classList.add('hidden');
  }

  function showLobby() {
    gameRunning = false;
    paused = false;
    pauseOverlay.classList.add('hidden');
    pauseBtn.classList.remove('show');
    overlay.classList.remove('hidden');
    lobbyScreen.classList.remove('hidden');
    modeScreen.classList.add('hidden');
    shopScreen.classList.add('hidden');
    loadoutScreen.classList.add('hidden');
    profileScreen.classList.add('hidden');
    bossBar.classList.remove('show');
    const mode = getMode(save.mode);
    const rank = getRank();
    const nextRank = getNextRank();
    const progressInfo = nextRank
      ? ('До ' + nextRank.name + ': ' + (nextRank.threshold - (save.profile ? save.profile.points : 0)) + ' очков')
      : 'Максимальное звание!';
    const profileBadge = save.profile
      ? '<div class="profile-badge">' +
          '<div class="profile-avatar">' + (save.profile.avatar || '🪖') + '</div>' +
          '<div class="profile-info">' +
            '<div class="profile-name">' + save.profile.nickname + '</div>' +
            '<div class="profile-rank">' + rank.icon + ' ' + rank.name + '</div>' +
            '<div class="profile-points">' + (save.profile.points || 0) + ' очков · ' + progressInfo + '</div>' +
          '</div>' +
        '</div>'
      : '';
    lobbyScreen.innerHTML =
      profileBadge +
      '<h1>NFT SHOOTER</h1>' +
      '<p>🕹 Левый джойстик — ходьба</p>' +
      '<p>🎯 Правый джойстик — прицел и стрельба</p>' +
      '<p>🔫 Кнопки справа — смена оружия</p>' +
      '<p>🌊 15 волн, на финальной — БОСС</p>' +
      '<div class="balance">Баланс: <b id="lobbyBalance2">' + save.balance + '</b> 💎</div>' +
      '<div id="continueWrap" class="hidden" style="width:100%;display:flex;flex-direction:column;align-items:center;">' +
        '<p style="font-size:12px;color:#44ff88;margin-bottom:6px;">Найден незавершённый бой</p>' +
        '<button id="continueBtn2" class="menu-btn continue-btn">ПРОДОЛЖИТЬ (Волна <span id="contWave2">1</span>)</button>' +
      '</div>' +
      '<button id="startBtn2" class="menu-btn">НОВЫЙ БОЙ</button>' +
      '<button id="modeBtn2" class="menu-btn mode-btn">РЕЖИМ: <span id="modeLabel2">' + mode.name.toUpperCase() + '</span></button>' +
      '<button id="loadoutBtn2" class="menu-btn" style="border-color:#44ff88;color:#44ff88;text-shadow:0 0 10px #44ff88;box-shadow:0 0 20px rgba(68,255,136,0.4);">ОРУЖИЕ В БОЙ</button>' +
      '<button id="shopBtn2" class="menu-btn" style="border-color:#ffaa00;color:#ffaa00;text-shadow:0 0 10px #ffaa00;box-shadow:0 0 20px rgba(255,170,0,0.4);">МАГАЗИН</button>';
    document.getElementById('startBtn2').addEventListener('click', e => { e.preventDefault(); startGame(); });
    document.getElementById('shopBtn2').addEventListener('click', e => { e.preventDefault(); showShop(); });
    document.getElementById('modeBtn2').addEventListener('click', e => { e.preventDefault(); showModes(); });
    document.getElementById('loadoutBtn2').addEventListener('click', e => { e.preventDefault(); showLoadout(); });
    document.getElementById('continueBtn2').addEventListener('click', e => { e.preventDefault(); continueGame(); });
    refreshContinueButton();
  }

  function showModes() {
    overlay.classList.remove('hidden');
    lobbyScreen.classList.add('hidden');
    shopScreen.classList.add('hidden');
    loadoutScreen.classList.add('hidden');
    profileScreen.classList.add('hidden');
    modeScreen.classList.remove('hidden');
    renderModes();
  }

  function renderModes() {
    modeGrid.innerHTML = '';
    MODES.forEach(m => {
      const card = document.createElement('div');
      card.className = 'mode-card' + (save.mode === m.id ? ' selected' : '');
      card.innerHTML =
        `<div class="mode-icon">${m.icon}</div>` +
        `<div class="mode-info">` +
          `<div class="mode-title">${m.name}</div>` +
          `<div class="mode-desc">${m.desc}</div>` +
          `<span class="mode-tag ${m.tag}">${m.tagText}</span>` +
        `</div>`;
      card.addEventListener('click', e => {
        e.preventDefault();
        save.mode = m.id;
        persist();
        modeLabel.textContent = m.name.toUpperCase();
        renderModes();
      });
      modeGrid.appendChild(card);
    });
  }

  function showShop() {
    overlay.classList.remove('hidden');
    lobbyScreen.classList.add('hidden');
    modeScreen.classList.add('hidden');
    loadoutScreen.classList.add('hidden');
    profileScreen.classList.add('hidden');
    shopScreen.classList.remove('hidden');
    renderShop();
  }

  function showLoadout() {
    overlay.classList.remove('hidden');
    lobbyScreen.classList.add('hidden');
    modeScreen.classList.add('hidden');
    shopScreen.classList.add('hidden');
    profileScreen.classList.add('hidden');
    loadoutScreen.classList.remove('hidden');
    renderLoadout();
  }

  function renderLoadout() {
    loadoutGrid.innerHTML = '';
    const ownedList = WEAPONS.filter(w => save.ownedWeapons.includes(w.id));
    ownedList.forEach(w => {
      const inLoadout = save.loadout.includes(w.id);
      const equipped = save.equippedWeapon === w.id;
      const card = document.createElement('div');
      card.className = 'weapon-card' + (inLoadout ? '' : ' locked') + (equipped ? ' equipped' : '') + (w.isMelee ? ' melee-card' : '');
      let action;
      if (inLoadout) {
        action = equipped
          ? `<button class="owned" disabled>В РУКАХ</button>`
          : `<button class="equip" data-loadout-toggle="${w.id}">УБРАТЬ</button>`;
      } else {
        action = `<button class="buy" data-loadout-toggle="${w.id}">ВЗЯТЬ В БОЙ</button>`;
      }
      let statsHtml;
      if (w.isMelee) {
        statsHtml = `Урон: ${w.damage} · Вращается вокруг тебя<br>Радиус: ${w.orbitRadius}`;
      } else {
        const effective = getWeaponWithAtts(w.id);
        statsHtml = `Урон: ${Math.round(effective.damage)} · Дробин: ${w.pellets}`;
      }
      card.innerHTML =
        `<div class="weapon-icon">${w.icon}</div>` +
        `<div class="weapon-info">` +
          `<div class="weapon-title">${w.name}${w.isMelee ? '<span class="weapon-tag-melee">ВРАЩЕНИЕ</span>' : ''}</div>` +
          `<div class="weapon-stats">${statsHtml}</div>` +
          `<div class="weapon-stats" style="color:${inLoadout ? '#44ff88' : '#888'};margin-top:4px;">${inLoadout ? '✓ ВЗЯТО В БОЙ' : '— не взято'}</div>` +
        `</div>` +
        `<div class="weapon-action">${action}</div>`;
      loadoutGrid.appendChild(card);
    });

    const header = document.createElement('div');
    header.style.cssText = 'grid-column:span 3;font-size:12px;color:#a0f0ff;text-align:center;padding:6px;';
    header.textContent = `Выбрано: ${save.loadout.length} / ${MAX_LOADOUT}`;
    loadoutGrid.insertBefore(header, loadoutGrid.firstChild);

    loadoutGrid.querySelectorAll('[data-loadout-toggle]').forEach(btn => {
      btn.addEventListener('click', e => {
        e.preventDefault();
        const id = btn.dataset.loadoutToggle;
        const idx = save.loadout.indexOf(id);
        if (idx >= 0) {
          if (save.loadout.length <= 1) {
            btn.textContent = 'МИНИМУМ 1';
            setTimeout(() => renderLoadout(), 700);
            return;
          }
          save.loadout.splice(idx, 1);
          if (save.equippedWeapon === id) {
            save.equippedWeapon = save.loadout[0];
          }
        } else {
          if (save.loadout.length >= MAX_LOADOUT) {
            btn.textContent = `МАКС ${MAX_LOADOUT}`;
            setTimeout(() => renderLoadout(), 700);
            return;
          }
          save.loadout.push(id);
        }
        persist();
        renderLoadout();
      });
    });
  }

  function togglePause(force) {
    if (!gameRunning) return;
    paused = (force !== undefined) ? force : !paused;
    if (paused) {
      pauseOverlay.classList.remove('hidden');
      pauseBtn.textContent = '▶';
      saveBattle(true);
      persist();
    } else {
      pauseOverlay.classList.add('hidden');
      pauseBtn.textContent = '⏸';
    }
  }

  pauseBtn.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); togglePause(true); });
  document.getElementById('resumeBtn').addEventListener('click', e => { e.preventDefault(); togglePause(false); });
  document.getElementById('pauseLobbyBtn').addEventListener('click', e => {
    e.preventDefault();
    paused = false;
    pauseOverlay.classList.add('hidden');
    pauseBtn.classList.remove('show');
    showLobby();
  });
  window.addEventListener('keydown', e => {
    if ((e.key === 'Escape' || e.key === 'p' || e.key === 'P' || e.key === 'з' || e.key === 'З') && gameRunning) {
      togglePause();
    }
  });

  document.getElementById('startBtn').addEventListener('click', e => { e.preventDefault(); startGame(); });
  document.getElementById('modeBtn').addEventListener('click', e => { e.preventDefault(); showModes(); });
  document.getElementById('modeBackBtn').addEventListener('click', e => { e.preventDefault(); showLobby(); });
  document.getElementById('loadoutBtn').addEventListener('click', e => { e.preventDefault(); showLoadout(); });
  document.getElementById('loadoutBackBtn').addEventListener('click', e => { e.preventDefault(); showLobby(); });
  document.getElementById('shopBtn').addEventListener('click', e => { e.preventDefault(); showShop(); });
  document.getElementById('shopBackBtn').addEventListener('click', e => { e.preventDefault(); showLobby(); });
  document.getElementById('continueBtn').addEventListener('click', e => { e.preventDefault(); continueGame(); });
  rollBtn.addEventListener('click', e => { e.preventDefault(); rollCase(); });

  document.querySelectorAll('.shop-tab').forEach(tab => {
    tab.addEventListener('click', e => {
      e.preventDefault();
      shopTab = tab.dataset.tab;
      document.querySelectorAll('.shop-tab').forEach(t => t.classList.toggle('active', t === tab));
      renderShop();
    });
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      persist();
      if (gameRunning) {
        saveBattle(true);
        if (!paused) togglePause(true);
      }
    }
  });
  window.addEventListener('pagehide', () => { persist(); if (gameRunning) saveBattle(true); });
  window.addEventListener('beforeunload', () => { persist(); if (gameRunning) saveBattle(true); });

  // ===== ПРОФИЛЬ =====
  function showProfileScreen() {
    overlay.classList.remove('hidden');
    lobbyScreen.classList.add('hidden');
    modeScreen.classList.add('hidden');
    shopScreen.classList.add('hidden');
    loadoutScreen.classList.add('hidden');
    pauseBtn.classList.remove('show');
    bossBar.classList.remove('show');
    profileScreen.classList.remove('hidden');
    renderProfileScreen();
  }

  function renderProfileScreen() {
    const grid = document.getElementById('avatarGrid');
    if (grid.dataset.rendered) return;
    grid.innerHTML = '';
    AVATARS.forEach((emoji, i) => {
      const btn = document.createElement('div');
      btn.className = 'avatar-btn' + (i === 0 ? ' selected' : '');
      btn.dataset.index = i;
      btn.textContent = emoji;
      btn.addEventListener('click', e => {
        e.preventDefault();
        grid.querySelectorAll('.avatar-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        grid.dataset.selected = i;
      });
      grid.appendChild(btn);
    });
    grid.dataset.rendered = '1';
    grid.dataset.selected = 0;
  }

  function submitProfile() {
    const nickInput = document.getElementById('nickInput');
    const nick = (nickInput.value || '').trim();
    if (nick.length < 2 || nick.length > 12) {
      nickInput.style.borderColor = '#ff3264';
      nickInput.placeholder = 'Ник должен быть 2-12 символов';
      setTimeout(() => { nickInput.style.borderColor = ''; }, 1400);
      return;
    }
    const grid = document.getElementById('avatarGrid');
    const avatarIndex = parseInt(grid.dataset.selected || '0', 10);
    save.profile = {
      nickname: nick,
      avatar: AVATARS[avatarIndex] || AVATARS[0],
      points: 0
    };
    persist();
    profileScreen.classList.add('hidden');
    showLobby();
  }

  const profileSubmitBtn = document.getElementById('profileSubmitBtn');
  const nickInput = document.getElementById('nickInput');
  if (profileSubmitBtn) {
    profileSubmitBtn.addEventListener('click', e => { e.preventDefault(); submitProfile(); });
  }
  if (nickInput) {
    nickInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') { e.preventDefault(); submitProfile(); }
    });
  }

  modeLabel.textContent = getMode(save.mode).name.toUpperCase();
  initGame();
  gameRunning = false;

  if (!save.profile) {
    showProfileScreen();
  } else {
    showLobby();
  }

  requestAnimationFrame(loop);
})();
</script>
</body>
</html>