  let shopTab = 'player';

  function updateRollBtn() {
    const free = caseIsFree();
    if (free) {
      rollBtn.textContent = 'ОТКРЫТЬ КЕЙС — БЕСПЛАТНО';
      rollBtn.classList.add('free');
