  function renderAttachments() {
    shopGrid.innerHTML = '';
    ATTACHMENTS.forEach(att => {
      const card = document.createElement('div');
      card.className = 'att-card';
      const ownedWeaponIds = save.ownedWeapons.filter(wid => att.weapons.includes(wid));
