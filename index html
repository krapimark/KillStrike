<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>NFT Shooter</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none; -webkit-user-select:none; }
  html, body { width:100%; height:100%; background:#0a0a1a; overflow:hidden; font-family:'Courier New', monospace; touch-action:none; }
  #game { position:fixed; top:0; left:0; width:100vw; height:100vh; overflow:hidden; }
  canvas { display:block; position:absolute; top:0; left:0; }

  #hud { position:absolute; top:8px; left:12px; right:12px; display:flex; justify-content:space-between; color:#00f0ff; font-size:13px; text-shadow:0 0 10px #00f0ff; pointer-events:none; z-index:10; }
  #hud .right { text-align:right; }
  #hud .mode-tag { font-size:10px; color:#ffaa00; text-shadow:0 0 8px #ffaa00; margin-top:2px; }

  #bossBar { position:absolute; top:44px; left:50%; transform:translateX(-50%); width:min(70%, 420px); z-index:12; pointer-events:none; display:none; }
  #bossBar.show { display:block; }
  #bossBar .bossLabel { font-size:11px; color:#ff2266; text-shadow:0 0 10px #ff2266; text-align:center; margin-bottom:3px; letter-spacing:2px; }
  #bossBar .bossTrack { height:10px; background:rgba(0,0,0,0.7); border:1px solid rgba(255,50,100,0.6); border-radius:5px; overflow:hidden; box-shadow:0 0 14px rgba(255,50,100,0.5); }
  #bossBar .bossFill { height:100%; width:100%; background:linear-gradient(90deg,#ff2266,#aa00ff); transition:width 0.15s; }

  .joystick { position:absolute; bottom:16px; width:110px; height:110px; border-radius:50%; border:2px solid rgba(0,240,255,0.4); background:rgba(0,240,255,0.05); z-index:20; touch-action:none; }
  #joyMove { left:16px; }
  #joyShoot { right:16px; border-color:rgba(255,50,100,0.5); background:rgba(255,50,100,0.05); }
  .joyKnob { position:absolute; width:50px; height:50px; border-radius:50%; background:rgba(0,240,255,0.4); border:2px solid #00f0ff; box-shadow:0 0 15px #00f0ff; top:50%; left:50%; transform:translate(-50%,-50%); pointer-events:none; }
  #joyShoot .joyKnob { background:rgba(255,50,100,0.4); border-color:#ff3264; box-shadow:0 0 15px #ff3264; }

  #weapons { position:absolute; bottom:150px; right:16px; display:flex; flex-direction:column; gap:6px; z-index:20; }
  .wbtn { width:50px; height:50px; border-radius:50%; background:rgba(0,0,0,0.6); border:2px solid rgba(0,240,255,0.5); color:#00f0ff; font-size:18px; display:flex; flex-direction:column; align-items:center; justify-content:center; font-family:'Courier New', monospace; text-shadow:0 0 8px #00f0ff; transition:all 0.15s; touch-action:manipulation; cursor:pointer; position:relative; }
  .wbtn.active { background:rgba(0,240,255,0.3); box-shadow:0 0 20px #00f0ff; }
  .wbtn .lbl { font-size:8px; opacity:0.8; }
  .wbtn .att-dot { position:absolute; top:2px; right:2px; width:6px; height:6px; border-radius:50%; background:#44ff88; box-shadow:0 0 6px #44ff88; }
  .wbtn.grenade { border-color:rgba(170,0,255,0.7); color:#c6f; text-shadow:0 0 8px #aa00ff; }
  .wbtn.grenade.active { background:rgba(170,0,255,0.3); box-shadow:0 0 20px #aa00ff; }
  .wbtn.grenade:disabled { opacity:0.35; cursor:default; }

  #overlay { position:absolute; top:0; left:0; width:100%; height:100%; display:flex; flex-direction:column; justify-content:flex-start; align-items:center; background:rgba(0,0,0,0.92); color:#00f0ff; text-shadow:0 0 20px #00f0ff; text-align:center; z-index:100; padding:16px; overflow-y:auto; -webkit-overflow-scrolling:touch; }
  #overlay h1 { font-size:26px; margin-bottom:10px; }
  #overlay p { font-size:12px; margin:4px 0; color:#a0f0ff; max-width:340px; }
  #overlay button { margin-top:12px; padding:12px 36px; font-size:16px; background:transparent; border:2px solid #00f0ff; color:#00f0ff; border-radius:8px; font-family:'Courier New', monospace; text-shadow:0 0 10px #00f0ff; box-shadow:0 0 20px rgba(0,240,255,0.5); touch-action:manipulation; cursor:pointer; }
  .hidden { display:none !important; }

  .menu-screen { width:100%; max-width:460px; display:flex; flex-direction:column; align-items:center; padding-bottom:20px; }
  .menu-screen h1 { margin-bottom:8px; }
  .balance { font-size:15px; color:#ffaa00; text-shadow:0 0 12px #ffaa00; margin:8px 0 14px; }
  .balance b { font-size:20px; }
  .menu-btn { width:100%; max-width:300px; }
  .mode-btn { border-color:#ffaa00 !important; color:#ffaa00 !important; text-shadow:0 0 10px #ffaa00 !important; box-shadow:0 0 20px rgba(255,170,0,0.4) !important; }
  .back-btn { margin-top:14px; padding:10px 28px !important; font-size:14px !important; border-color:#ff3264 !important; color:#ff3264 !important; text-shadow:0 0 10px #ff3264 !important; box-shadow:0 0 20px rgba(255,50,100,0.4) !important; }
  .continue-btn { border-color:#44ff88 !important; color:#44ff88 !important; text-shadow:0 0 10px #44ff88 !important; box-shadow:0 0 20px rgba(68,255,136,0.5) !important; }

  .avatar-grid { display:grid; grid-template-columns:repeat(4, 1fr); gap:8px; width:100%; max-width:320px; margin:12px 0; justify-items:center; }
  .avatar-btn { font-size:32px; width:56px; height:56px; border-radius:50%; background:rgba(0,240,255,0.1); border:2px solid rgba(0,240,255,0.4); display:flex; align-items:center; justify-content:center; cursor:pointer; touch-action:manipulation; transition:all 0.15s; }
  .avatar-btn.selected { border-color:#44ff88; box-shadow:0 0 16px rgba(68,255,136,0.6); background:rgba(68,255,136,0.15); }
  .nick-input { width:100%; max-width:300px; padding:12px; font-size:16px; font-family:'Courier New', monospace; background:rgba(0,0,0,0.5); border:2px solid rgba(0,240,255,0.5); border-radius:8px; color:#00f0ff; text-align:center; margin:10px 0; outline:none; text-shadow:0 0 8px #00f0ff; }
  .nick-input:focus { border-color:#00f0ff; box-shadow:0 0 14px rgba(0,240,255,0.5); }
  .profile-badge { display:flex; flex-direction:row; align-items:center; gap:10px; background:rgba(0,240,255,0.08); border:1px solid rgba(0,240,255,0.3); border-radius:12px; padding:8px 14px; margin-bottom:10px; max-width:340px; width:100%; }
  .profile-avatar { font-size:32px; width:48px; height:48px; border-radius:50%; background:rgba(0,240,255,0.15); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .profile-info { flex:1; text-align:left; }
  .profile-name { font-size:15px; color:#fff; font-weight:bold; }
  .profile-rank { font-size:11px; color:#ffaa00; margin-top:2px; }
  .profile-points { font-size:10px; color:#a0f0ff; margin-top:1px; }

  .shop-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:8px; width:100%; margin:10px 0; }
  .skin-card { background:rgba(0,240,255,0.06); border:1px solid rgba(0,240,255,0.3); border-radius:10px; padding:6px; display:flex; flex-direction:column; align-items:center; gap:5px; position:relative; }
  .skin-card.locked { opacity:0.35; filter:grayscale(1); }
  .skin-card.equipped { border-color:#00f0ff; box-shadow:0 0 18px rgba(0,240,255,0.6); }
  .skin-swatch { width:34px; height:34px; border-radius:50%; border:2px solid #fff; }
  .skin-name { font-size:10px; color:#a0f0ff; text-align:center; line-height:1.15; min-height:24px; }
  .skin-rarity { font-size:8px; padding:2px 5px; border-radius:4px; }
  .r-common  { background:rgba(160,160,160,0.3); color:#ccc; }
  .r-rare    { background:rgba(0,150,255,0.3);  color:#4af; }
  .r-epic    { background:rgba(170,0,255,0.3);  color:#c6f; }
  .r-legend  { background:rgba(255,180,0,0.3);  color:#fc4; }
  .skin-card button { font-size:9px; padding:3px 8px; border-radius:6px; background:transparent; border:1px solid #00f0ff; color:#00f0ff; margin-top:2px; touch-action:manipulation; cursor:pointer; }
  .skin-card.equipped button { background:rgba(0,240,255,0.3); }
  .shop-tabs { display:flex; gap:6px; margin:6px 0; flex-wrap:wrap; justify-content:center; }
  .shop-tab { padding:6px 12px; font-size:11px; border:1px solid rgba(0,240,255,0.4); border-radius:6px; color:#00f0ff; background:transparent; touch-action:manipulation; cursor:pointer; }
  .shop-tab.active { background:rgba(0,240,255,0.25); box-shadow:0 0 12px rgba(0,240,255,0.5); }
  .roll-btn { padding:14px 32px; font-size:16px; background:transparent; border:2px solid #ffaa00; color:#ffaa00; border-radius:10px; text-shadow:0 0 12px #ffaa00; box-shadow:0 0 24px rgba(255,170,0,0.5); margin-top:8px; touch-action:manipulation; cursor:pointer; }
  .roll-btn:disabled { opacity:0.4; box-shadow:none; cursor:default; }
  .roll-btn.free { border-color:#44ff88; color:#44ff88; text-shadow:0 0 12px #44ff88; box-shadow:0 0 24px rgba(68,255,136,0.5); }

  .weapon-card { grid-column: span 3; display:flex; flex-direction:row; align-items:center; gap:10px; background:rgba(0,240,255,0.06); border:1px solid rgba(0,240,255,0.3); border-radius:10px; padding:8px 10px; }
  .weapon-card.locked { opacity:0.5; }
  .weapon-card.equipped { border-color:#44ff88; box-shadow:0 0 18px rgba(68,255,136,0.5); }
  .weapon-card.melee-card { border-color:rgba(255,170,68,0.4); background:rgba(255,170,68,0.06); }
  .weapon-icon { font-size:28px; width:44px; text-align:center; flex-shrink:0; }
  .weapon-info { flex:1; text-align:left; }
  .weapon-title { font-size:13px; color:#fff; font-weight:bold; }
  .weapon-tag-melee { font-size:9px; color:#ffaa44; background:rgba(255,170,68,0.2); padding:1px 5px; border-radius:3px; margin-left:4px; }
  .weapon-stats { font-size:10px; color:#a0f0ff; margin-top:2px; line-height:1.3; }
  .weapon-att-badges { display:flex; gap:3px; margin-top:3px; flex-wrap:wrap; }
  .att-badge { font-size:8px; padding:1px 5px; border-radius:4px; background:rgba(68,255,136,0.25); color:#44ff88; border:1px solid rgba(68,255,136,0.5); }
  .weapon-action { flex-shrink:0; }
  .weapon-action button { font-size:11px; padding:6px 12px; border-radius:6px; background:transparent; border:1px solid #ffaa00; color:#ffaa00; touch-action:manipulation; cursor:pointer; }
  .weapon-action button:disabled { opacity:0.5; border-color:#666; color:#888; cursor:default; }
  .weapon-action button.buy { border-color:#ffaa00; color:#ffaa00; }
  .weapon-action button.equip { border-color:#44ff88; color:#44ff88; }
  .weapon-action button.owned { border-color:#00f0ff; color:#00f0ff; }

  .att-section { width:100%; margin-top:10px; }
  .att-section h3 { font-size:13px; color:#a0f0ff; text-align:left; margin-bottom:6px; text-shadow:0 0 10px #00f0ff; }
  .att-card { display:flex; flex-direction:row; align-items:center; gap:10px; background:rgba(0,240,255,0.06); border:1px solid rgba(0,240,255,0.3); border-radius:10px; padding:8px 10px; margin-bottom:6px; }
  .att-card.owned { border-color:#44ff88; box-shadow:0 0 12px rgba(68,255,136,0.4); }
  .att-icon { font-size:26px; width:40px; text-align:center; flex-shrink:0; }
  .att-info { flex:1; text-align:left; }
  .att-title { font-size:12px; color:#fff; font-weight:bold; }
  .att-desc { font-size:10px; color:#a0f0ff; margin-top:2px; line-height:1.3; }
  .att-weapons { font-size:9px; color:#888; margin-top:2px; }
  .att-action button { font-size:11px; padding:6px 12px; border-radius:6px; background:transparent; border:1px solid #ffaa00; color:#ffaa00; touch-action:manipulation; cursor:pointer; }
  .att-action button:disabled { opacity:0.5; border-color:#666; color:#888; cursor:default; }
  .att-action button.owned { border-color:#44ff88; color:#44ff88; }

  .mode-grid { display:flex; flex-direction:column; gap:10px; width:100%; max-width:400px; margin:14px 0; }
  .mode-card { display:flex; flex-direction:row; align-items:center; gap:12px; background:rgba(0,240,255,0.06); border:2px solid rgba(0,240,255,0.3); border-radius:12px; padding:12px; cursor:pointer; touch-action:manipulation; text-align:left; transition:all 0.15s; }
  .mode-card:hover, .mode-card:active { border-color:#00f0ff; box-shadow:0 0 16px rgba(0,240,255,0.5); }
  .mode-card.selected { border-color:#44ff88; box-shadow:0 0 20px rgba(68,255,136,0.6); background:rgba(68,255,136,0.08); }
  .mode-icon { font-size:38px; width:56px; text-align:center; flex-shrink:0; }
  .mode-info { flex:1; }
  .mode-title { font-size:15px; color:#fff; font-weight:bold; text-shadow:0 0 10px #00f0ff; }
  .mode-desc { font-size:11px; color:#a0f0ff; margin-top:3px; line-height:1.3; }
  .mode-tag { font-size:9px; margin-top:4px; display:inline-block; padding:2px 8px; border-radius:4px; }
  .tag-normal { background:rgba(0,240,255,0.2); color:#00f0ff; }
  .tag-zombie { background:rgba(68,255,68,0.2); color:#44ff44; }
  .tag-space { background:rgba(170,0,255,0.2); color:#c6f; }

  #caseAnim { position:absolute; top:0; left:0; width:100%; height:100%; display:flex; flex-direction:column; justify-content:center; align-items:center; background:rgba(0,0,0,0.95); z-index:200; padding:16px; }
  #caseReel { width:100%; max-width:420px; height:110px; overflow:hidden; border:2px solid #ffaa00; border-radius:10px; position:relative; box-shadow:0 0 30px rgba(255,170,0,0.5); }
  #caseTrack { display:flex; height:100%; align-items:center; will-change:transform; }
  .reel-item { flex:0 0 100px; height:90px; margin:0 5px; display:flex; flex-direction:column; align-items:center; justify-content:center; border-radius:8px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.15); }
  .reel-item .skin-swatch { width:40px; height:40px; }
  #caseReel::after { content:''; position:absolute; top:0; left:50%; width:3px; height:100%; background:#ff3264; transform:translateX(-50%); box-shadow:0 0 14px #ff3264; }
  #caseResult { margin-top:18px; font-size:16px; text-align:center; min-height:60px; }
  #caseResult .skin-name { font-size:15px; color:#fff; }
  #caseCloseBtn { margin-top:14px; }

  .save-indicator { position:absolute; top:8px; left:50%; transform:translateX(-50%); font-size:10px; color:#44ff88; text-shadow:0 0 8px #44ff88; z-index:11; pointer-events:none; opacity:0; transition:opacity 0.4s; }
  .save-indicator.show { opacity:1; }

  .pause-btn { position:absolute; top:8px; left:50%; transform:translateX(-50%); width:42px; height:42px; border-radius:50%; background:rgba(0,0,0,0.65); border:2px solid rgba(0,240,255,0.5); color:#00f0ff; font-size:18px; display:none; align-items:center; justify-content:center; z-index:15; cursor:pointer; touch-action:manipulation; text-shadow:0 0 10px #00f0ff; box-shadow:0 0 14px rgba(0,240,255,0.4); }
  .pause-btn.show { display:flex; }
  #pauseOverlay { position:absolute; top:0; left:0; width:100%; height:100%; display:flex; flex-direction:column; justify-content:center; align-items:center; background:rgba(0,0,0,0.85); z-index:150; padding:20px; text-align:center; }
</style>
</head>
<body>
<div id="game">
  <canvas id="canvas"></canvas>
  <div class="save-indicator" id="saveIndicator">💾 СОХРАНЕНО</div>
  <div id="hud">
    <div>
      <div>🔫 <span id="score">0</span></div>
      <div>💎 <span id="nftCount">0</span></div>
      <div class="mode-tag" id="hudMode">ОБЫЧНЫЙ</div>
    </div>
    <div class="right"><div>❤️ <span id="hp">100</span></div><div>🌊 <span id="wave">1</span>/15</div></div>
  </div>
  <div id="bossBar">
    <div class="bossLabel">☠ БОСС ☠</div>
    <div class="bossTrack"><div class="bossFill" id="bossFill"></div></div>
  </div>
  <div class="joystick" id="joyMove"><div class="joyKnob" id="knobMove"></div></div>
  <div class="joystick" id="joyShoot"><div class="joyKnob" id="knobShoot"></div></div>
  <div id="weapons"></div>

  <button id="pauseBtn" class="pause-btn">⏸</button>
  <div id="pauseOverlay" class="hidden">
    <h1 style="color:#00f0ff;text-shadow:0 0 20px #00f0ff;font-size:32px;margin-bottom:16px;">ПАУЗА</h1>
    <button id="resumeBtn" class="menu-btn" style="width:100%;max-width:300px;">ПРОДОЛЖИТЬ</button>
    <button id="pauseLobbyBtn" class="back-btn">В ЛОББИ</button>
  </div>

  <div id="overlay">
    <div class="menu-screen hidden" id="profileScreen">
      <h1 style="color:#44ff88;text-shadow:0 0 20px #44ff88;">СОЗДАЙ ПРОФИЛЬ</h1>
      <p>Выбери аватар и придумай ник</p>
      <div class="avatar-grid" id="avatarGrid"></div>
      <input type="text" id="nickInput" class="nick-input" placeholder="Твой ник (2-12 символов)" maxlength="12">
      <button id="profileSubmitBtn" class="menu-btn" style="border-color:#44ff88;color:#44ff88;text-shadow:0 0 10px #44ff88;box-shadow:0 0 20px rgba(68,255,136,0.5);">СОЗДАТЬ ПРОФИЛЬ</button>
    </div>

    <div class="menu-screen" id="lobbyScreen">
      <h1>NFT SHOOTER</h1>
      <p>🕹 Левый джойстик — ходьба</p>
      <p>🎯 Правый джойстик — прицел и стрельба</p>
      <p>🔫 Кнопки справа — смена оружия</p>
      <p>🌊 15 волн, на финальной — БОСС</p>
      <div class="balance">Баланс: <b id="lobbyBalance">0</b> 💎</div>
      <div id="continueWrap" class="hidden" style="width:100%;display:flex;flex-direction:column;align-items:center;">
        <p style="font-size:12px;color:#44ff88;margin-bottom:6px;">Найден незавершённый бой</p>
        <button id="continueBtn" class="menu-btn continue-btn">ПРОДОЛЖИТЬ (Волна <span id="contWave">1</span>)</button>
      </div>
      <button id="startBtn" class="menu-btn">НОВЫЙ БОЙ</button>
      <button id="modeBtn" class="menu-btn mode-btn">РЕЖИМ: <span id="modeLabel">ОБЫЧНЫЙ</span></button>
      <button id="loadoutBtn" class="menu-btn" style="border-color:#44ff88;color:#44ff88;text-shadow:0 0 10px #44ff88;box-shadow:0 0 20px rgba(68,255,136,0.4);">ОРУЖИЕ В БОЙ</button>
      <button id="shopBtn" class="menu-btn" style="border-color:#ffaa00;color:#ffaa00;text-shadow:0 0 10px #ffaa00;box-shadow:0 0 20px rgba(255,170,0,0.4);">МАГАЗИН</button>
    </div>

    <div class="menu-screen hidden" id="modeScreen">
      <h1 style="color:#ffaa00;text-shadow:0 0 20px #ffaa00;">ВЫБОР РЕЖИМА</h1>
      <div class="mode-grid" id="modeGrid"></div>
      <button id="modeBackBtn" class="back-btn">НАЗАД</button>
    </div>

    <div class="menu-screen hidden" id="loadoutScreen">
      <h1 style="color:#44ff88;text-shadow:0 0 20px #44ff88;">ОРУЖИЕ В БОЙ</h1>
      <p style="font-size:11px;color:#a0f0ff;margin-bottom:8px;">Выбери до 5 видов (минимум 1). В бою будут только отмеченные.</p>
      <div class="shop-grid" id="loadoutGrid"></div>
      <button id="loadoutBackBtn" class="back-btn">НАЗАД</button>
    </div>

    <div class="menu-screen hidden" id="shopScreen">
      <h1 style="color:#ffaa00;text-shadow:0 0 20px #ffaa00;">МАГАЗИН</h1>
      <div class="balance">Баланс: <b id="shopBalance">0</b> 💎</div>
      <button id="rollBtn" class="roll-btn">ОТКРЫТЬ КЕЙС — 20 💎</button>
      <div class="shop-tabs">
        <button class="shop-tab active" data-tab="player">Игрок</button>
        <button class="shop-tab" data-tab="enemy">Враги</button>
        <button class="shop-tab" data-tab="nft">NFT</button>
        <button class="shop-tab" data-tab="weapon">ОРУЖИЕ</button>
        <button class="shop-tab" data-tab="att">ОБВЕСЫ</button>
      </div>
      <div class="shop-grid" id="shopGrid"></div>
      <button id="shopBackBtn" class="back-btn">НАЗАД</button>
    </div>
  </div>

  <div id="caseAnim" class="hidden">
    <h1 style="color:#ffaa00;text-shadow:0 0 20px #ffaa00;margin-bottom:16px;">ОТКРЫТИЕ КЕЙСА</h1>
    <div id="caseReel"><div id="caseTrack"></div></div>
    <div id="caseResult"></div>
    <button id="caseCloseBtn" class="back-btn hidden">ЗАБРАТЬ</button>
  </div>
</div>

<script>
(function() {
  'use strict';

  const canvas = document.getElementById('canvas');
  const ctx = canvas.getContext('2d');
  let W = window.innerWidth;
  let H = window.innerHeight;

  function resize() {
    W = window.innerWidth;
    H = window.innerHeight;
    if (W < 10 || H < 10) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.floor(W * dpr);
