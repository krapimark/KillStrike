  function getWeaponWithAtts(weaponId) {
    if (MODE_WEAPONS[weaponId]) {
      return { ...MODE_WEAPONS[weaponId], activeAtts: [] };
    }
    const base = WEAPONS.find(w => w.id === weaponId) || WEAPONS[0];
    if (base.isMelee) {
      return { ...base, activeAtts: [] };
    }
    const owned = save.ownedAtts[weaponId] || [];
    let damage = base.damage;
    let spread = base.spread;
    let speed = base.speed;
    const active = [];
    for (const attId of owned) {
      const att = getAttachment(attId);
      if (!att || !att.weapons.includes(weaponId)) continue;
      active.push(att);
      if (att.stat === 'damage') damage *= att.mult;
      else if (att.stat === 'accuracy') {
        spread = spread / att.mult;
        speed = speed * 1.1;
      }
    }
    return { ...base, damage, spread, speed, activeAtts: active };
  }

