  function scaleMap(map) {
    const px = (v) => v * W;
    const py = (v) => v * H;
    return map.obst.map(o => {
      if (o.type === 'rect') return { type:'rect', x:px(o.x), y:py(o.y), w:px(o.w), h:py(o.h) };
      if (o.type === 'circle') return { type:'circle', cx:px(o.cx), cy:py(o.cy), r: Math.min(px(o.r), py(o.r)) };
      if (o.type === 'poly') return { type:'poly', points:o.points.map(p => ({ x:px(p.x), y:py(p.y) })) };
      return o;
    });
  }

  let currentMap = null;
  let currentMapDef = null;

  function pointInObstacle(x, y, r, obst) {
    for (const o of obst) {
      if (o.type === 'rect') {
        const nx = Math.max(o.x, Math.min(x, o.x + o.w));
        const ny = Math.max(o.y, Math.min(y, o.y + o.h));
        if (Math.hypot(x - nx, y - ny) < r) return true;
      } else if (o.type === 'circle') {
        if (Math.hypot(x - o.cx, y - o.cy) < o.r + r) return true;
      } else if (o.type === 'poly') {
        let inside = false;
        const pts = o.points;
        for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
          const xi = pts[i].x, yi = pts[i].y, xj = pts[j].x, yj = pts[j].y;
          if (((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi)) inside = !inside;
        }
        if (inside) return true;
        for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
          const ax = pts[j].x, ay = pts[j].y, bx = pts[i].x, by = pts[i].y;
          const dx = bx - ax, dy = by - ay;
          const len2 = dx*dx + dy*dy || 1;
          let t = ((x - ax) * dx + (y - ay) * dy) / len2;
          t = Math.max(0, Math.min(1, t));
          const px2 = ax + t * dx, py2 = ay + t * dy;
          if (Math.hypot(x - px2, y - py2) < r) return true;
        }
      }
    }
    return false;
  }

  function hitsObstacle(x, y, r) {
    if (!currentMap) return false;
    return pointInObstacle(x, y, r, currentMap);
  }

  function resolveCollision(x, y, r) {
    for (let iter = 0; iter < 3; iter++) {
      let moved = false;
      for (const o of currentMap) {
        if (o.type === 'rect') {
          const nx = Math.max(o.x, Math.min(x, o.x + o.w));
          const ny = Math.max(o.y, Math.min(y, o.y + o.h));
          const dx = x - nx, dy = y - ny;
          const d = Math.hypot(dx, dy);
          if (d < r) {
            if (d < 0.0001) {
              const toLeft = x - o.x, toRight = (o.x + o.w) - x;
              const toTop = y - o.y, toBottom = (o.y + o.h) - y;
              const minH = Math.min(toLeft, toRight);
              const minV = Math.min(toTop, toBottom);
              if (minH < minV) x = toLeft < toRight ? o.x - r : o.x + o.w + r;
              else y = toTop < toBottom ? o.y - r : o.y + o.h + r;
            } else {
              const push = (r - d) / d;
              x += dx * push; y += dy * push;
            }
            moved = true;
          }
        } else if (o.type === 'circle') {
          const dx = x - o.cx, dy = y - o.cy;
          const d = Math.hypot(dx, dy);
          const minD = o.r + r;
          if (d < minD) {
            if (d < 0.0001) x += minD;
            else { const push = (minD - d) / d; x += dx * push; y += dy * push; }
            moved = true;
          }
        } else if (o.type === 'poly') {
          const pts = o.points;
          let inside = false;
          for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
            const xi = pts[i].x, yi = pts[i].y, xj = pts[j].x, yj = pts[j].y;
            if (((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi)) inside = !inside;
          }
          if (inside) {
            let bestDist = Infinity, bestPx = x, bestPy = y;
            for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
              const ax = pts[j].x, ay = pts[j].y, bx = pts[i].x, by = pts[i].y;
              const dx = bx - ax, dy = by - ay;
              const len2 = dx*dx + dy*dy || 1;
              let t = ((x - ax) * dx + (y - ay) * dy) / len2;
              t = Math.max(0, Math.min(1, t));
              const px2 = ax + t * dx, py2 = ay + t * dy;
              const dd = Math.hypot(x - px2, y - py2);
              if (dd < bestDist) { bestDist = dd; bestPx = px2; bestPy = py2; }
            }
            const ddx = x - bestPx, ddy = y - bestPy;
            const dn = Math.hypot(ddx, ddy) || 1;
            x = bestPx + (ddx / dn) * r;
            y = bestPy + (ddy / dn) * r;
            moved = true;
          } else {
            for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
              const ax = pts[j].x, ay = pts[j].y, bx = pts[i].x, by = pts[i].y;
              const dx = bx - ax, dy = by - ay;
              const len2 = dx*dx + dy*dy || 1;
              let t = ((x - ax) * dx + (y - ay) * dy) / len2;
              t = Math.max(0, Math.min(1, t));
              const px2 = ax + t * dx, py2 = ay + t * dy;
              const dd = Math.hypot(x - px2, y - py2);
              if (dd < r) {
                const push = (r - dd) / (dd || 1);
                x += (x - px2) * push;
                y += (y - py2) * push;
                moved = true;
              }
            }
          }
        }
      }
      if (!moved) break;
    }
    return { x, y };
  }

  function isFreeSpot(x, y, r) {
    if (x < r || x > W - r || y < r || y > H - r) return false;
    return !hitsObstacle(x, y, r);
  }

  function findFreeSpot(cx, cy, r) {
    if (isFreeSpot(cx, cy, r)) return { x: cx, y: cy };
    for (let ring = 1; ring < 40; ring++) {
      const dist = ring * 10;
      for (let a = 0; a < 16; a++) {
        const ang = (a / 16) * Math.PI * 2;
        const x = cx + Math.cos(ang) * dist;
        const y = cy + Math.sin(ang) * dist;
        if (isFreeSpot(x, y, r)) return { x, y };
      }
    }
    return { x: W / 2, y: H / 2 };
  }

