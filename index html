        `<div style="width:56px;height:56px;border-radius:50%;margin:0 auto 6px;background:${swatchColor};box-shadow:0 0 24px ${swatchColor};"></div>` +
        `<div class="skin-name" style="font-size:16px;color:#fff;">${winner.skin.name}</div>` +
        `<div class="skin-rarity r-${winner.skin.rarity}" style="display:inline-block;margin-top:6px;">${RARITY_LABEL[winner.skin.rarity]}</div>` +
        `<div style="font-size:11px;color:#a0f0ff;margin-top:4px;">Категория: ${cat === 'player' ? 'Игрок' : cat === 'enemy' ? 'Враги' : 'NFT'}</div>`;

