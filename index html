  const joyMove  = { active:false, id:null, dx:0, dy:0, baseX:0, baseY:0 };
  const joyShoot = { active:false, id:null, dx:0, dy:0, baseX:0, baseY:0 };

  function setupJoystick(el, knobEl, state) {
    const R = 46;
    function getPoint(e) {
      if (e.changedTouches) return e.changedTouches[0];
      if (e.touches) return e.touches[0];
      return e;
    }
    function onStart(e) {
      e.preventDefault();
      if (paused) return;
      const t = getPoint(e);
      const rect = el.getBoundingClientRect();
      state.id = t.identifier !== undefined ? t.identifier : 'mouse';
      state.active = true;
      state.baseX = rect.left + rect.width / 2;
      state.baseY = rect.top + rect.height / 2;
      onMove(e);
    }
    function onMove(e) {
      if (!state.active) return;
      e.preventDefault();
      const list = e.changedTouches || (e.touches && e.touches.length ? e.touches : [e]);
      for (let i = 0; i < list.length; i++) {
        const t = list[i];
        const id = t.identifier !== undefined ? t.identifier : 'mouse';
        if (id !== state.id) continue;
        let dx = t.clientX - state.baseX;
        let dy = t.clientY - state.baseY;
        const dist = Math.hypot(dx, dy);
        if (dist > R) { dx = dx / dist * R; dy = dy / dist * R; }
        state.dx = dx / R;
        state.dy = dy / R;
        knobEl.style.transform = 'translate(calc(-50% + ' + dx + 'px), calc(-50% + ' + dy + 'px))';
      }
    }
    function onEnd(e) {
      if (!state.active) return;
      const list = e.changedTouches || [e];
      for (let i = 0; i < list.length; i++) {
        const t = list[i];
        const id = t.identifier !== undefined ? t.identifier : 'mouse';
        if (id !== state.id) continue;
        state.active = false;
        state.id = null;
        state.dx = 0;
        state.dy = 0;
        knobEl.style.transform = 'translate(-50%, -50%)';
      }
    }
    el.addEventListener('touchstart', onStart, { passive:false });
    el.addEventListener('touchmove', onMove, { passive:false });
    el.addEventListener('touchend', onEnd);
    el.addEventListener('touchcancel', onEnd);
    el.addEventListener('mousedown', onStart);
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup', onEnd);
  }

