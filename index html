  function renderWeapons() {
    shopGrid.innerHTML = '';
    WEAPONS.forEach(w => {
      const owned = save.ownedWeapons.includes(w.id);
      const equipped = save.equippedWeapon === w.id;
      const card = document.createElement('div');
      card.className = 'weapon-card' + (owned ? '' : ' locked') + (equipped ? ' equipped' : '') + (w.isMelee ? ' melee-card' : '');
      let action;
      if (!owned) {
        if (w.price === 0) action = `<button class="buy" disabled>БАЗОВОЕ</button>`;
        else {
          const can = save.balance >= w.price;
          action = `<button class="buy" data-buy="${w.id}" ${can ? '' : 'disabled'}>${w.price} 💎</button>`;
        }
      } else if (equipped) action = `<button class="owned" disabled>В РУКАХ</button>`;
      else action = `<button class="equip" data-equip-w="${w.id}">ВЗЯТЬ</button>`;

      let statsHtml;
      let attBadges = '';
      if (w.isMelee) {
        const spinLabel = w.orbitSpeed >= 0.16 ? 'оч. высокая' : w.orbitSpeed >= 0.14 ? 'высокая' : 'средняя';
        statsHtml = `Урон: ${w.damage} · Вращается вокруг тебя<br>Радиус: ${w.orbitRadius} · Скорость: ${spinLabel}`;
      } else {
        const effective = getWeaponWithAtts(w.id);
        statsHtml = `Урон: ${Math.round(effective.damage)} · Скорость: ${w.cooldown <= 4 ? 'оч. высокая' : w.cooldown <= 12 ? 'высокая' : w.cooldown <= 24 ? 'средняя' : 'низкая'}<br>Дробин: ${w.pellets} · Разброс: ${(effective.spread*100).toFixed(1)}%`;
        if (owned && effective.activeAtts.length) {
          attBadges = `<div class="weapon-att-badges">${effective.activeAtts.map(a => `<span class="att-badge">${a.icon} ${a.name}</span>`).join('')}</div>`;
        }
      }

      card.innerHTML =
        `<div class="weapon-icon">${w.icon}</div>` +
        `<div class="weapon-info">` +
          `<div class="weapon-title">${w.name}${w.isMelee ? '<span class="weapon-tag-melee">ВРАЩЕНИЕ</span>' : ''}</div>` +
          `<div class="weapon-stats">${statsHtml}</div>` +
          attBadges +
        `</div>` +
        `<div class="weapon-action">${action}</div>`;
      shopGrid.appendChild(card);
    });

    shopGrid.querySelectorAll('[data-buy]').forEach(btn => {
      btn.addEventListener('click', e => {
        e.preventDefault();
        const id = btn.dataset.buy;
        const w = getWeapon(id);
        if (save.balance < w.price || save.ownedWeapons.includes(id)) return;
        save.balance -= w.price;
        save.ownedWeapons.push(id);
        save.equippedWeapon = id;
        if (Array.isArray(save.loadout) && save.loadout.length < MAX_LOADOUT) {
          save.loadout.push(id);
        }
        persist();
        renderShop();
        buildWeaponsBar();
      });
    });

    shopGrid.querySelectorAll('[data-equip-w]').forEach(btn => {
      btn.addEventListener('click', e => {
        e.preventDefault();
        save.equippedWeapon = btn.dataset.equipW;
        if (Array.isArray(save.loadout) && !save.loadout.includes(save.equippedWeapon) && save.loadout.length < MAX_LOADOUT) {
          save.loadout.push(save.equippedWeapon);
        }
        persist();
        renderShop();
        buildWeaponsBar();
      });
