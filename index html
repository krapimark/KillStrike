  function restoreBattle(data) {
    if (data.mode) save.mode = data.mode;
    if (typeof data.mapIndex === 'number' && MAPS[data.mapIndex]) {
      currentMapDef = MAPS[data.mapIndex];
      currentMap = scaleMap(currentMapDef);
    } else chooseRandomMap();

    const pSkin = getSkin('player', save.equipped.player);
    player = {
      x: data.player.x, y: data.player.y, r: data.player.r || 18, speed: 3.8,
      hp: data.player.hp, maxHp: data.player.maxHp || 100,
      shootCooldown: data.player.shootCooldown || 0,
      invuln: data.player.invuln || 0,
      aimAngle: data.player.aimAngle || 0,
      walkPhase: data.player.walkPhase || 0,
      skin: pSkin,
      grenades: data.player.grenades || 0,
      knifeAngle: data.player.knifeAngle || 0
    };
    score = data.score || 0;
    nftCount = data.nftCount || 0;
    wave = data.wave || 1;
    spawnTimer = data.spawnTimer || 40;
    battlePointsEarned = data.battlePointsEarned || 0;

    if (data.weapons && data.weapons.equipped) {
      save.equippedWeapon = data.weapons.equipped;
      if (!save.loadout.includes(save.equippedWeapon) && save.loadout.length < MAX_LOADOUT) {
        save.loadout.push(save.equippedWeapon);
      }
      currentWeapon = getWeaponWithAtts(data.weapons.current || save.equippedWeapon);
    }

    bullets = (data.bullets || []).map(b => ({...b}));
    enemies = (data.enemies || []).map(e => ({...e}));
    enemyBullets = (data.enemyBullets || []).map(b => ({...b}));
    nfts = (data.nfts || []).map(n => ({...n}));
    particles = [];
    thrownGrenades = [];

    if (data.boss) boss = {...data.boss};
    else boss = null;

    victoryTriggered = false;

    const mode = getMode(save.mode);
    hudMode.textContent = mode.name.toUpperCase();

    updateBossBar();
    updateUI();
    buildWeaponsBar();
  }

  function updateUI() {
    if (!player) return;
    scoreEl.textContent = score;
    nftEl.textContent = nftCount;
    hpEl.textContent = Math.max(0, Math.round(player.hp));
    waveEl.textContent = wave;
    updateGrenadeButton();
  }

  function updateBossBar() {
    if (boss) {
      bossBar.classList.add('show');
      bossFill.style.width = Math.max(0, (boss.hp / boss.maxHp) * 100) + '%';
    } else bossBar.classList.remove('show');
  }

  function spawnEnemy() {
    const colors = getEnemyColors();
    const types = [
      { color: colors.a, r:16, hp:25, speed:1.6, shoot:false, score:10 },
      { color: colors.b, r:14, hp:20, speed:1.2, shoot:true,  score:20 },
      { color: colors.c, r:24, hp:60, speed:0.8, shoot:false, score:30 },
    ];
    const maxType = Math.min(types.length - 1, Math.floor(wave / 2));
    const type = types[Math.floor(Math.random() * (maxType + 1))];
    let x, y;
    const edge = Math.floor(Math.random() * 4);
    if (edge === 0) { x = 40 + Math.random() * (W - 80); y = -40; }
    else if (edge === 1) { x = W + 40; y = 40 + Math.random() * (H - 80); }
    else if (edge === 2) { x = 40 + Math.random() * (W - 80); y = H + 40; }
    else { x = -40; y = 40 + Math.random() * (H - 80); }

    const hp = type.hp + wave * 6;
    enemies.push({
      x, y, r: type.r, hp, maxHp: hp,
      speed: type.speed + wave * 0.1,
      color: type.color, shoot: type.shoot, score: type.score,
      shootCooldown: 60 + Math.random() * 60,
      angle: 0, walkPhase: Math.random() * Math.PI * 2
    });
  }

  function spawnBoss() {
    const spot = findFreeSpot(W / 2, H * 0.25, 60);
    boss = {
      x: spot.x, y: spot.y,
      r: 60,
      hp: 3000, maxHp: 3000,
      speed: 0.6,
      color: '#ff2266',
      accent: '#aa00ff',
      angle: 0,
      walkPhase: 0,
      shootCd: 90,
      summonCd: 300,
      phase: 1,
      invisible: 0,
      hitFlash: 0
    };
    updateBossBar();
  }

  function spawnNFT(x, y) {
    const spot = findFreeSpot(x, y, 10);
    const s = getSkin('nft', save.equipped.nft);
    nfts.push({
      x: spot.x, y: spot.y, r: 10, life: 400,
      bob: Math.random() * Math.PI * 2,
      hue: s.hueShift ? Math.random() * 360 : (s.hue || 190),
      hueShift: !!s.hueShift
    });
  }

  function shoot(angle) {
    const w = currentWeapon;
    if (w.isMelee) return;
    for (let p = 0; p < w.pellets; p++) {
      const a = angle + (Math.random() - 0.5) * w.spread * 2;
      const sx = player.x + Math.cos(a) * player.r;
      const sy = player.y + Math.sin(a) * player.r;
      if (hitsObstacle(sx, sy, w.bulletR)) continue;
      bullets.push({
        x: sx, y: sy,
        vx: Math.cos(a) * w.speed, vy: Math.sin(a) * w.speed,
        r: w.bulletR, life: 150, damage: w.damage, color: w.color
      });
    }
    player.shootCooldown = w.cooldown;
  }

  function explode(x, y, color, count) {
    for (let i = 0; i < count; i++) {
      const a = Math.random() * Math.PI * 2;
      const sp = 1 + Math.random() * 5;
      particles.push({
        x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,
        life: 30 + Math.random() * 20, maxLife: 50,
        color, r: 2 + Math.random() * 3
      });
    }
  }

  function updateKnifeDamage() {
    if (!currentWeapon.isMelee || !player) return;
    const w = currentWeapon;
    const now = performance.now();
    const bx = player.x + Math.cos(player.knifeAngle) * w.orbitRadius;
    const by = player.y + Math.sin(player.knifeAngle) * w.orbitRadius;

    for (let i = enemies.length - 1; i >= 0; i--) {
      const e = enemies[i];
      const d = Math.hypot(bx - e.x, by - e.y);
      if (d < w.bladeR + e.r) {
        if (!e._lastKnifeHit || now - e._lastKnifeHit > 220) {
          e.hp -= w.damage;
          e._lastKnifeHit = now;
          explode(bx, by, w.color, 5);
          if (e.hp <= 0) {
            score += e.score;
            explode(e.x, e.y, e.color, 22);
            if (Math.random() < 0.4) spawnNFT(e.x, e.y);
            enemies.splice(i, 1);
            updateUI();
          }
        }
      }
    }

    if (boss) {
      const d = Math.hypot(bx - boss.x, by - boss.y);
      if (d < w.bladeR + boss.r) {
        if (!boss._lastKnifeHit || now - boss._lastKnifeHit > 220) {
          boss.hp -= w.damage;
          boss.hitFlash = 8;
          boss._lastKnifeHit = now;
          updateBossBar();
          if (boss.hp <= 0) {
            explode(boss.x, boss.y, '#ff2266', 80);
            explode(boss.x, boss.y, '#aa00ff', 80);
            for (let k = 0; k < 10; k++) spawnNFT(boss.x + (Math.random()-0.5)*80, boss.y + (Math.random()-0.5)*80);
            score += 500; nftCount += 10;
            updateUI();
            boss = null; updateBossBar();
            victory(); return;
          }
        }
      }
    }
  }

