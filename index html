  function renderShop() {
    lobbyBalance.textContent = save.balance;
    shopBalance.textContent = save.balance;
    updateRollBtn();
    rollBtn.style.display = (shopTab === 'weapon' || shopTab === 'att') ? 'none' : '';
    if (shopTab === 'weapon') { renderWeapons(); return; }
    if (shopTab === 'att') { renderAttachments(); return; }

    const list = SKINS[shopTab];
    shopGrid.innerHTML = '';
    list.forEach(skin => {
      const owned = save.owned[shopTab].includes(skin.id);
      const equipped = save.equipped[shopTab] === skin.id;
      const card = document.createElement('div');
      card.className = 'skin-card' + (owned ? '' : ' locked') + (equipped ? ' equipped' : '');
      const swatchColor = skin.color || (skin.hueShift ? '#a0f0ff' : `hsl(${skin.hue||190},100%,60%)`);
      card.innerHTML =
        `<div class="skin-swatch" style="background:${swatchColor}; box-shadow:0 0 ${owned?14:0}px ${swatchColor};"></div>` +
        `<div class="skin-name">${skin.name}</div>` +
        `<div class="skin-rarity r-${skin.rarity}">${RARITY_LABEL[skin.rarity]}</div>` +
        (owned
          ? (equipped ? `<button disabled>ЭКИП.</button>` : `<button data-equip="${skin.id}">НАДЕТЬ</button>`)
          : `<button disabled>НЕ ОТКР.</button>`);
      shopGrid.appendChild(card);
    });

    shopGrid.querySelectorAll('[data-equip]').forEach(btn => {
      btn.addEventListener('click', e => {
        e.preventDefault();
        save.equipped[shopTab] = btn.dataset.equip;
        persist();
        renderShop();
      });
    });
