  function updateGrenadeButton() {
    const gBtn = document.getElementById('grenadeBtn');
    if (!gBtn) return;
    const cnt = document.getElementById('grenadeCount');
    if (cnt) cnt.textContent = player ? (player.grenades || 0) : 0;
    gBtn.disabled = !player || (player.grenades || 0) <= 0;
  }

  let thrownGrenades = [];

  function throwGrenade() {
    if (!player || save.mode !== 'space') return;
    if ((player.grenades || 0) <= 0) return;
    player.grenades--;
    const a = player.aimAngle;
    const dist = Math.min(300, Math.max(150, W * 0.3));
    const targetX = player.x + Math.cos(a) * dist;
    const targetY = player.y + Math.sin(a) * dist;
    thrownGrenades.push({
      x: player.x, y: player.y,
      startX: player.x, startY: player.y,
      targetX, targetY,
      t: 0, total: 40,
      r: 8
    });
    updateGrenadeButton();
  }

  function updateGrenades() {
    for (let i = thrownGrenades.length - 1; i >= 0; i--) {
      const g = thrownGrenades[i];
      g.t++;
      const k = g.t / g.total;
      g.x = g.startX + (g.targetX - g.startX) * k;
      g.y = g.startY + (g.targetY - g.startY) * k;
      if (g.t >= g.total) {
        explodeGrenade(g.x, g.y);
        thrownGrenades.splice(i, 1);
      }
    }
  }

  function explodeGrenade(x, y) {
    const radius = Math.min(W, H) * 0.18;
    for (let i = enemies.length - 1; i >= 0; i--) {
      const e = enemies[i];
      const d = Math.hypot(e.x - x, e.y - y);
      if (d < radius + e.r) {
        const dmg = 300 * (1 - Math.min(1, d / (radius + e.r)) * 0.5);
        e.hp -= dmg;
        if (e.hp <= 0) {
          score += e.score;
          explode(e.x, e.y, e.color, 22);
          if (Math.random() < 0.4) spawnNFT(e.x, e.y);
          enemies.splice(i, 1);
          updateUI();
        }
      }
    }
    if (boss) {
      const d = Math.hypot(boss.x - x, boss.y - y);
      if (d < radius + boss.r) {
        const dmg = 500 * (1 - Math.min(1, d / (radius + boss.r)) * 0.5);
        boss.hp -= dmg;
        boss.hitFlash = 8;
        updateBossBar();
        if (boss.hp <= 0) {
          explode(boss.x, boss.y, '#ff2266', 80);
          explode(boss.x, boss.y, '#aa00ff', 80);
          for (let k = 0; k < 10; k++) spawnNFT(boss.x + (Math.random()-0.5)*80, boss.y + (Math.random()-0.5)*80);
          score += 500; nftCount += 10;
          updateUI();
          boss = null; updateBossBar();
          victory(); return;
        }
      }
    }
    explode(x, y, '#aa00ff', 60);
    explode(x, y, '#ff44ff', 40);
    const dToP = Math.hypot(player.x - x, player.y - y);
    if (dToP < radius + player.r && player.invuln <= 0) {
      player.hp -= 25;
      player.invuln = 40;
      updateUI();
    }
  }

